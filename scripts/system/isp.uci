delete network.lan
delete network.wan
delete network.wan6
delete network.@device[0]
set network.isp=interface
set network.isp.device=eth0
set network.isp.proto=static
set network.isp.ipaddr=192.0.2.1
set network.isp.netmask=255.255.255.0
set network.vlan201=device
set network.vlan201.type=8021q
set network.vlan201.ifname=eth0
set network.vlan201.vid=201
set network.vlan201.name=eth0.201
set network.isp201=interface
set network.isp201.device=eth0.201
set network.isp201.proto=static
set network.isp201.ipaddr=198.51.100.1
set network.isp201.netmask=255.255.255.0
delete dhcp.lan
delete dhcp.wan
set dhcp.isp=dhcp
set dhcp.isp.interface=isp
set dhcp.isp.start=100
set dhcp.isp.limit=50
set dhcp.isp.leasetime=1h
set dhcp.isp201=dhcp
set dhcp.isp201.interface=isp201
set dhcp.isp201.start=100
set dhcp.isp201.limit=50
set dhcp.isp201.leasetime=1h
set pppoe.server=pppoe_server
set pppoe.server.interface=isp
set pppoe.server.ac_name=uniwrt-isp
set pppoe.server.localip=203.0.113.1
set pppoe.server.firstremoteip=203.0.113.2
set pppoe.server.maxsessions=4
set pppoe.server.optionsfile=/lab/pppoe-server-options
