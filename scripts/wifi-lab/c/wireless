config wifi-device 'radio0'
	option type 'mac80211'
	option path 'virtual/mac80211_hwsim/hwsim4'
	option band '2g'
	option channel '1'
	option htmode 'HE20'
	option country 'US'

config wifi-iface 'sta_radio0'
	option device 'radio0'
	option network 'wwan'
	option mode 'sta'
	option ssid 'uniwrt-lab'
	option bssid '02:00:00:00:00:00'
	option encryption 'sae'
	option key 'uniwrt-lab-key'

config wifi-device 'radio1'
	option type 'mac80211'
	option path 'virtual/mac80211_hwsim/hwsim5'
	option band '5g'
	option channel '36'
	option htmode 'HE80'
	option country 'US'

config wifi-iface 'sta_radio1'
	option device 'radio1'
	option network 'wwan5'
	option mode 'sta'
	option ssid 'uniwrt-lab'
	option bssid '02:00:00:00:02:00'
	option encryption 'sae'
	option key 'uniwrt-lab-key'
