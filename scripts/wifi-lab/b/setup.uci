set system.@system[0].hostname=lab-ap
set network.bat0=interface
set network.bat0.proto=batadv
set network.bat0.routing_algo=BATMAN_IV
set network.bat0.bridge_loop_avoidance=1
set network.bat0.distributed_arp_table=1
set network.batmesh=interface
set network.batmesh.proto=batadv_hardif
set network.batmesh.master=bat0
set network.batwired=interface
set network.batwired.proto=batadv_hardif
set network.batwired.master=bat0
set network.batwired.device=bh0
set network.mesh_dev=device
set network.mesh_dev.name=br-mesh
set network.mesh_dev.type=bridge
add_list network.mesh_dev.ports=bat0
set network.mesh=interface
set network.mesh.device=br-mesh
set network.mesh.proto=static
set network.mesh.ipaddr=10.99.0.2/24
set dhcp.lan.ignore=1
set dhcp.lan.ra=disabled
set dhcp.lan.dhcpv6=disabled
add_list firewall.@zone[0].network=mesh
