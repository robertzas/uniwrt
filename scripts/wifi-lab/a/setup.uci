set system.@system[0].hostname=lab-gw
set network.bat0=interface
set network.bat0.proto=batadv
set network.bat0.routing_algo=BATMAN_IV
set network.bat0.bridge_loop_avoidance=1
set network.bat0.distributed_arp_table=1
set network.batmesh=interface
set network.batmesh.proto=batadv_hardif
set network.batmesh.master=bat0
set network.batwired=interface
set network.batwired.proto=batadv_hardif
set network.batwired.master=bat0
set network.batwired.device=bh0
set network.mesh_dev=device
set network.mesh_dev.name=br-mesh
set network.mesh_dev.type=bridge
add_list network.mesh_dev.ports=bat0
set network.mesh=interface
set network.mesh.device=br-mesh
set network.mesh.proto=static
set network.bat0.gw_mode=server
set network.mesh.ipaddr=10.99.0.1/24
set network.mesh.ip6assign=64
set dhcp.mesh=dhcp
set dhcp.mesh.interface=mesh
set dhcp.mesh.start=100
set dhcp.mesh.limit=50
set dhcp.mesh.leasetime=1h
set dhcp.mesh.dhcpv6=server
set dhcp.mesh.ra=server
set dhcp.lan.ignore=1
set dhcp.lan.ra=disabled
set dhcp.lan.dhcpv6=disabled
add_list firewall.@zone[0].network=mesh
add firewall zone
set firewall.@zone[-1].name=uw_bh
add_list firewall.@zone[-1].network=batwired
set firewall.@zone[-1].input=REJECT
set firewall.@zone[-1].output=ACCEPT
set firewall.@zone[-1].forward=REJECT
add firewall rule
set firewall.@rule[-1].name=Allow-uw_bh-MTU-probe
set firewall.@rule[-1].src=uw_bh
set firewall.@rule[-1].proto=icmp
add_list firewall.@rule[-1].icmp_type=echo-request
add_list firewall.@rule[-1].icmp_type=echo-reply
add_list firewall.@rule[-1].icmp_type=neighbour-solicitation
add_list firewall.@rule[-1].icmp_type=neighbour-advertisement
set firewall.@rule[-1].family=ipv6
set firewall.@rule[-1].target=ACCEPT
