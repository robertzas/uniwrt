#!/bin/sh /etc/rc.common
# uniwrt's transaction guard (D-012, D-069), installed with /etc/uniwrt/txn when management is
# enabled: at boot it rolls back a transaction that was never confirmed, before the network
# starts; while one is open, procd runs its dead-man timer and its reload.

# shellcheck disable=SC2034 # read by rc.common
START=13
# shellcheck disable=SC2034
USE_PROCD=1
TXN=/etc/uniwrt/txn

boot() {
	[ -x "$TXN" ] && "$TXN" boot >/dev/null
	start "$@"
}

start_service() {
	[ -x "$TXN" ] || return 0
	# shellcheck disable=SC3043 # procd's rc.common runs under ash, which has local
	local open id state
	open=$("$TXN" pending) || return 0
	id=${open% *}
	state=${open#* }
	procd_open_instance timer
	procd_set_param command "$TXN" wait "$id"
	procd_set_param respawn 3600 1 0
	procd_close_instance
	[ "$state" = reloading ] || return 0
	procd_open_instance reload
	procd_set_param command "$TXN" reload "$id"
	procd_close_instance
}
