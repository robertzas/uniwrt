~ wireless.uw_uniwrt_demo_5g
    ieee80211w: ∅ → '1'
~ wireless.uw_mesh
    mesh_rssi_threshold: ∅ → '-80'
~ dhcp.lan
    force: ∅ → '1'
    ra_flags: 'managed-config' 'other-config' → 'other-config'
