---
source: crates/render/tests/backhaul.rs
expression: network.to_file()
---

config interface 'loopback'
	option device 'lo'
	option proto 'static'
	list ipaddr '127.0.0.1/8'

config globals 'globals'
	option ula_prefix 'fd12:3456:789a::/48'
	option dhcp_default_duid '0004b1bdbfa2e391406aa5c928b467d1710b'

config device
	option name 'br-lan'
	option type 'bridge'
	list ports 'lan1'
	list ports 'lan2'
	list ports 'lan3'
	list ports 'lan4'
	list ports 'lan5'
	list ports 'bat0'
	option igmp_snooping '1'

config bridge-vlan
	option device 'br-lan'
	option vlan '1'
	list ports 'lan1:u*'
	list ports 'lan2:u*'
	list ports 'lan3:u*'
	list ports 'lan4:u*'
	list ports 'lan5:u*'
	list ports 'bat0:u*'

config bridge-vlan
	option device 'br-lan'
	option vlan '30'
	list ports 'lan1:t'
	list ports 'lan2:t'
	list ports 'lan3:t'
	list ports 'lan4:t'
	list ports 'lan5:t'
	list ports 'bat0:t'

config bridge-vlan
	option device 'br-lan'
	option vlan '40'
	list ports 'lan1:t'
	list ports 'lan2:t'
	list ports 'lan3:t'
	list ports 'lan4:t'
	list ports 'lan5:t'
	list ports 'bat0:t'

config interface 'lan'
	option device 'br-lan.1'
	option proto 'dhcp'

config interface 'iot'
	option device 'br-lan.30'
	option proto 'none'

config interface 'guest'
	option device 'br-lan.40'
	option proto 'none'

config interface 'bat0'
	option proto 'batadv'
	option routing_algo 'BATMAN_V'
	option bridge_loop_avoidance '1'
	option distributed_arp_table '1'
	option multicast_mode '1'
	option orig_interval '1000'
	option aggregated_ogms '1'
	option fragmentation '1'
	option gw_mode 'off'

config interface 'uw_mesh'
	option proto 'batadv_hardif'
	option master 'bat0'
	option mtu '1532'

config device
	option name 'lan1'
	option mtu '1532'

config device
	option type '8021q'
	option ifname 'lan1'
	option vid '4094'
	option name 'lan1.4094'
	option mtu '1532'

config interface 'uw_bh_lan1'
	option proto 'batadv_hardif'
	option master 'bat0'
	option device 'lan1.4094'

config device
	option name 'eth1'
	option mtu '1532'

config device
	option type '8021q'
	option ifname 'eth1'
	option vid '4094'
	option name 'eth1.4094'
	option mtu '1532'

config interface 'uw_bh_eth1'
	option proto 'batadv_hardif'
	option master 'bat0'
	option device 'eth1.4094'
