---
source: crates/render/tests/blocking.rs
expression: "format!(\"{}\\n{}\", shown.to_file(), redirects.to_file())"
---

config dnsmasq 'main'
	option domainneeded '1'
	option boguspriv '1'
	option filterwin2k '0'
	option localise_queries '1'
	option rebind_protection '1'
	option rebind_localhost '1'
	option local '/lan/'
	option domain 'lan'
	option expandhosts '1'
	option nonegcache '0'
	option cachesize '1000'
	option authoritative '1'
	option readethers '1'
	option leasefile '/tmp/dhcp.leases'
	option resolvfile '/tmp/resolv.conf.d/resolv.conf.auto'
	option nonwildcard '1'
	option localservice '1'
	option ednspacket_max '1232'
	option noresolv '1'
	list server '/0.openwrt.pool.ntp.org/9.9.9.9'
	list server '/1.openwrt.pool.ntp.org/9.9.9.9'
	list server '/2.openwrt.pool.ntp.org/9.9.9.9'
	list server '/3.openwrt.pool.ntp.org/9.9.9.9'
	list server '127.0.0.1#5053'
	option confdir '/tmp/dnsmasq.uniwrt.d,*.conf'
	option logqueries '1'

config dnsmasq 'unfiltered'
	option port '5354'
	option domainneeded '1'
	option boguspriv '1'
	option rebind_protection '1'
	option rebind_localhost '1'
	list rebind_domain 'lan'
	option nonwildcard '1'
	option localservice '1'
	option localuse '0'
	option cachesize '1000'
	option ednspacket_max '1232'
	option logqueries '1'
	option noresolv '1'
	list server '/lan/127.0.0.1'
	list server '/0.openwrt.pool.ntp.org/9.9.9.9'
	list server '/1.openwrt.pool.ntp.org/9.9.9.9'
	list server '/2.openwrt.pool.ntp.org/9.9.9.9'
	list server '/3.openwrt.pool.ntp.org/9.9.9.9'
	list server '127.0.0.1#5053'

config dhcp 'lan'
	option interface 'lan'
	option start '100'
	option limit '150'
	option leasetime '12h'
	option force '1'
	option dhcpv4 'server'
	list dhcp_option '42,0.0.0.0'
	option dhcpv6 'server'
	option ra 'server'
	option ra_slaac '1'
	list ra_flags 'other-config'
	option instance 'main'

config dhcp 'iot'
	option interface 'iot'
	option start '100'
	option limit '150'
	option leasetime '1h'
	option force '1'
	option dhcpv4 'server'
	list dhcp_option '42,0.0.0.0'
	option dhcpv6 'server'
	option ra 'server'
	option ra_slaac '1'
	list ra_flags 'other-config'
	option instance 'main'

config dhcp 'guest'
	option interface 'guest'
	option start '100'
	option limit '150'
	option leasetime '1h'
	option force '1'
	option dhcpv4 'server'
	list dhcp_option '42,0.0.0.0'
	option instance 'main'

config dhcp 'wan'
	option interface 'wan'
	option ignore '1'
	option instance 'main'



config redirect
	option name 'uniwrt_dns_bypass_lan'
	option target 'DNAT'
	option src 'lan'
	option family 'any'
	list proto 'tcp'
	list proto 'udp'
	list src_mac '02:00:00:00:10:01'
	list src_mac '02:00:00:00:10:02'
	option src_dport '53'
	option dest_port '5354'

config redirect
	option name 'uniwrt_dns_bypass_iot'
	option target 'DNAT'
	option src 'iot'
	option family 'any'
	list proto 'tcp'
	list proto 'udp'
	list src_mac '02:00:00:00:10:01'
	list src_mac '02:00:00:00:10:02'
	option src_dport '53'
	option dest_port '5354'

config redirect
	option name 'uniwrt_dns_bypass_guest'
	option target 'DNAT'
	option src 'guest'
	option family 'any'
	list proto 'tcp'
	list proto 'udp'
	list src_mac '02:00:00:00:10:01'
	list src_mac '02:00:00:00:10:02'
	option src_dport '53'
	option dest_port '5354'
