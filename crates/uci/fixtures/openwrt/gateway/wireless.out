package wireless

config wifi-device 'radio0'
	option type 'mac80211'
	option path 'platform/soc/18000000.wifi'
	option band '2g'
	option channel '6'
	option htmode 'HE20'
	option country 'US'
	option cell_density '0'

config wifi-device 'radio1'
	option type 'mac80211'
	option path 'platform/soc/18000000.wifi+1'
	option band '5g'
	option channel '36'
	option htmode 'HE80'
	option country 'US'

config wifi-iface 'uw_home_2g'
	option device 'radio0'
	option network 'lan'
	option mode 'ap'
	option ssid 'Home'
	option encryption 'sae-mixed'
	option key 'correct horse battery staple'
	option ieee80211r '1'
	option mobility_domain 'a1b2'
	option ft_over_ds '0'
	option ft_psk_generate_local '1'
	option ieee80211k '1'
	option bss_transition '1'

config wifi-iface 'uw_home_5g'
	option device 'radio1'
	option network 'lan'
	option mode 'ap'
	option ssid 'Home'
	option encryption 'sae-mixed'
	option key 'correct horse battery staple'
	option ieee80211r '1'
	option mobility_domain 'a1b2'

config wifi-iface 'uw_guest_2g'
	option device 'radio0'
	option network 'guest'
	option mode 'ap'
	option ssid 'Home Guest'
	option encryption 'psk2'
	option key 'it'\''s a "guest" key; #1'
	option isolate '1'

config wifi-iface 'uw_mesh'
	option device 'radio1'
	option network 'mesh'
	option mode 'mesh'
	option mesh_id 'uniwrt-mesh'
	option encryption 'sae'
	option key 'mesh secret'
	option mesh_fwding '0'
	option mesh_rssi_threshold '0'

