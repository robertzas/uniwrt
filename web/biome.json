{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true, "root": ".." },
  "files": { "includes": ["**", "!dist", "!src/api/gen", "!playwright-report", "!test-results"] },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "css": { "parser": { "tailwindDirectives": true } },
  "linter": {
    "rules": {
      "preset": "recommended",
      "style": { "noDefaultExport": "error", "useImportType": "error" },
      "suspicious": { "noExplicitAny": "error", "noConsole": "error" }
    }
  },
  "overrides": [
    {
      "includes": ["vite.config.ts", "playwright.config.ts"],
      "linter": { "rules": { "style": { "noDefaultExport": "off" } } }
    }
  ],
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
